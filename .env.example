# Copy to .env and fill in. Never commit the real .env (it's gitignored).

PORT=4000

# Postgres (docker-compose maps the container's 5432 to host 5433, to avoid
# colliding with a locally installed Postgres service on the default port)
DATABASE_URL=postgresql://autoinfra:autoinfra@localhost:5433/autoinfra

# Redis (BullMQ job queue, log pub/sub; host port 6380 for the same reason)
REDIS_URL=redis://localhost:6380

# Next.js dev server origin, for CORS + cookie SameSite config
WEB_ORIGIN=http://localhost:3000

# This API's own externally-reachable base URL, used to build the GitHub
# OAuth callback URL
API_BASE_URL=http://localhost:4000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
# Envelope-encryption key for sensitive DB columns (clean swap-in path to KMS later)
ENCRYPTION_KEY=

# Gemini API (https://ai.google.dev/) -- never hardcode a model name elsewhere, always read GEMINI_MODEL
GEMINI_API_KEY=
GEMINI_MODEL=

# Default AWS region suggestion for new connections (user can override per deployment)
AWS_REGION=us-east-1

# GitHub OAuth App (create at https://github.com/settings/developers -- see docs/github-oauth-setup.md)
# Callback URL for local dev: http://localhost:4000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: shared Terraform provider cache for the validation gauntlet. The
# AWS provider is ~700 MB; without a cache every validation re-downloads it.
# e.g. C:/Users/<you>/AppData/Local/autoinfra/tf-plugin-cache (must exist)
TF_PLUGIN_CACHE_DIR=

# Steps (analyze, design, generate, apply) one user may have running at once
# across all their deployments. Destroy is never blocked by this.
MAX_RUNNING_JOBS_PER_USER=3
