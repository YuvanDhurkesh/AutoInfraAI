# Generated by AutoInfra for a Python backend without its own Dockerfile.
# Base images come from AWS's mirror of Docker Official Images: Docker Hub
# refuses CodeBuild's shared addresses with 429 Too Many Requests.
FROM public.ecr.aws/docker/library/python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# Compilers and libpq for packages without wheels (psycopg2, mysqlclient, ...).
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential libpq-dev default-libmysqlclient-dev pkg-config \
  && rm -rf /var/lib/apt/lists/*
COPY . .
RUN {{INSTALL_COMMAND}}{{#if RUNTIME_NEEDS}} \
  && pip install --no-cache-dir {{RUNTIME_NEEDS}}{{/if}}
# Unprivileged user that owns the app folder (uploads, SQLite still work).
RUN useradd --create-home --uid 10001 app && chown -R app:app /app
USER app
EXPOSE {{PORT}}
CMD ["sh", "-c", {{RUN_COMMAND_JSON}}]
