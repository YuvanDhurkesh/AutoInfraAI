# Generated by AutoInfra for a Node backend without its own Dockerfile.
# Base images come from AWS's mirror of Docker Official Images: Docker Hub
# refuses CodeBuild's shared addresses with 429 Too Many Requests.
# Build stage has compilers for native modules; the runtime stage is slim.
FROM public.ecr.aws/docker/library/node:22 AS build
WORKDIR /app
COPY . .
RUN {{INSTALL_COMMAND}}{{#if PRISMA_GENERATE}} \
  && npx prisma generate{{/if}}{{#if BUILD_SCRIPT}} \
  && {{BUILD_SCRIPT}}{{/if}}{{#if PRUNE}} \
  && npm prune --omit=dev{{/if}}

FROM public.ecr.aws/docker/library/node:22-slim
WORKDIR /app
ENV NODE_ENV=production
# Runs as the image's unprivileged "node" user, which owns the app folder
# itself too (an app that creates uploads/ or a SQLite file at startup).
RUN chown node:node /app
COPY --from=build --chown=node:node /app ./
USER node
EXPOSE {{PORT}}
CMD ["sh", "-c", {{RUN_COMMAND_JSON}}]
