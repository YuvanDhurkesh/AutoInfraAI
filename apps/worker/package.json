    "@autoinfra/scanner": "workspace:*",
    "@autoinfra/aws": "workspace:*",
    "@autoinfra/terraform-runner": "workspace:*",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
